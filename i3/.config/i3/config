# ───────────────────────────────
# i3 config (v4) — Nikita edition
# ───────────────────────────────

set $mod Mod4

# ─── Мониторы ──────────────────
set $fm eDP
set $sm HDMI-A-0
bindsym $mod+Shift+m exec --no-startup-id xrandr --output $fm --off --output $sm --primary --auto
bindsym $mod+Shift+n exec --no-startup-id xrandr --output $fm --auto --primary --output $sm --off

# ─── Автозапуск ────────────────
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id dunst
exec --no-startup-id light-locker --lock-on-suspend
exec_always --no-startup-id nm-applet
exec_always --no-startup-id xfce4-power-manager --daemon

exec_always --no-startup-id feh --bg-fill /home/nikita/Изображения/wall.jpg
exec_always --no-startup-id xset r rate 200 35
#запуск i3
exec --no-startup-id dex --autostart --environment i3

# ─── Системные утилиты ─────────
bindsym Print exec --no-startup-id flameshot gui
bindsym XF86Calculator exec --no-startup-id galculator
for_window [class="Galculator"] floating enable, move position center, border normal
bindsym $mod+End exec rofi -show power-menu -modi "power-menu:/home/nikita/.local/bin/rofi-power-menu"

# ─── Терминал ──────────────────
bindsym $mod+Return exec alacritty

# ─── Управление окнами ─────────
bindsym $mod+w kill
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+backslash split h
bindsym $mod+equal split v
bindsym $mod+f fullscreen toggle
# bindsym $mod+s layout stacking
bindsym $mod+m layout tabbed
bindsym $mod+s layout toggle split
# bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ─── Запуск приложений ─────────
bindsym $mod+d exec "rofi -modi drun,run -show drun"

# ─── Рабочие столы ─────────────
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ─── Звук (PipeWire/Pulse) ─────
set $refresh_i3status killall -SIGUSR1 i3status

bindsym XF86AudioRaiseVolume exec --no-startup-id amixer set Master 5%+ unmute && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id amixer set Master 5%- unmute && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id amixer set Master toggle && $refresh_i3status

# set $refresh_i3status killall -SIGUSR1 i3status
# bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
# bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
# bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
# bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# ─── Внешний вид ───────────────
font pango:Droid Sans M Nerd Font Mono 10
# titlebar_padding 2
gaps outer 2
gaps inner 2
for_window [class="Polybar"] gaps inner 0
focus_follows_mouse no
# for_window [class=".*"] border pixel 1
# hide_edge_borders smart
# default_border pixel 1
# new_float normal

bindsym $mod+Shift+space floating toggle; [tiling con_id=__focused__] border none; [floating con_id=__focused__] border normal
default_border pixel 2
default_floating_border normal

set $base00 #000000
set $base01 #121212
set $base02 #222222
set $base03 #333333
set $base04 #999999
set $base05 #c1c1c1
set $base06 #999999
set $base07 #c1c1c1
set $base08 #5f8787
set $base09 #aaaaaa
set $base0A #a06666
set $base0B #dd9999
set $base0C #aaaaaa

# Basic color configuration using the Base16 variables for windows and borders.
# Property Name         Border  BG      Text    Indicator Child Border
client.focused          $base05 $base0D $base00 $base0D $base0C
client.focused_inactive $base01 $base01 $base05 $base03 $base01
client.unfocused        $base01 $base00 $base05 $base01 $base01
client.urgent           $base08 $base08 $base00 $base08 $base08
client.placeholder      $base00 $base00 $base05 $base00 $base00
client.background       $base07

#Мои хоткеи
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Pause exec i3lock 

#Правила окон
assign [class="TelegramDesktop"] 10
